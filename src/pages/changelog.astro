---
import PageTitle from "@/components/common/PageTitle.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const changelog = [
	{
		version: "v1.0",
		date: "2026-08-09",
		title: "博客全新上线",
		items: [
			"基于 Firefly-Mod 主题深度魔改，黑白极简风格",
			"随机壁纸背景（t.alcy.cc API）",
			"接入 Twikoo 评论系统",
			"网易云音乐播放器（255 首歌单，随机播放）",
			"对话式互动首页 + 动态时间线",
		],
	},
];

const title = "更新日志";
const description = "博客的每一次成长都记录在这里";
---

<MainGridLayout title={title} description={description} hasOwnH1={true}>
	<div class="card-base px-9 py-6 relative z-10">
		<PageTitle title={title} description={description} />

		<div class="mt-8 space-y-8">
			{changelog.map((log) => (
				<div class="border-l-2 border-(--primary) pl-5">
					<div class="flex items-center gap-3">
						<span class="font-bold text-lg">{log.version}</span>
						<span class="text-sm text-neutral-500">{log.date}</span>
					</div>
					<p class="mt-1 text-neutral-600 dark:text-neutral-300">{log.title}</p>
					<ul class="mt-3 list-disc list-inside text-sm space-y-1">
						{log.items.map((item) => <li>{item}</li>)}
					</ul>
				</div>
			))}
		</div>
	</div>
</MainGridLayout>
