---
import Comment from "@components/comment/index.astro";
import PageTitle from "@/components/common/PageTitle.astro";
import {
	commentConfig,
	friendsPageConfig,
	getEnabledFriends,
	siteConfig,
} from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// 检查页面是否启用
if (!siteConfig.pages.friends) {
	return Astro.redirect("/404/");
}

// 检查评论系统是否启用
const isCommentEnabled =
	commentConfig?.type &&
	commentConfig.type !== "none" &&
	friendsPageConfig.showComment !== false;

// 使用配置文件中的友链数据，按权重排序
const items = getEnabledFriends();
const siteInfo = friendsPageConfig.siteInfo;

// 页面标题和描述
const title = friendsPageConfig.title || i18n(I18nKey.friends);
const description =
	friendsPageConfig.description || i18n(I18nKey.friendsDescription);
---

<MainGridLayout title={title} description={description} hasOwnH1={true}>
	<div class="card-base z-10 px-4 sm:px-6 lg:px-9 py-6 relative w-full">
		<div class="mb-5">
			<PageTitle title={title} variant="stacked" />
			<p class="mt-2 max-w-2xl text-sm leading-6 text-(--content-meta)">{description}</p>
		</div>

		<!-- 本站信息 -->
		{siteInfo && (
			<div class="flex flex-col sm:flex-row sm:items-center gap-4 rounded-2xl border border-(--line-divider) p-5">
				<img src={siteInfo.avatar} alt={siteInfo.name} class="w-16 h-16 rounded-xl object-cover shrink-0" loading="lazy" />
				<div class="flex-1 min-w-0">
					<h3 class="font-bold text-lg">{siteInfo.name}</h3>
					<p class="text-sm text-(--content-meta) mt-0.5">{siteInfo.desc}</p>
					<p class="text-xs text-(--content-meta) mt-1.5 break-all">
						{siteInfo.url} · {siteInfo.email}
					</p>
				</div>
				{friendsPageConfig.applyLink && (
					<a
						href={friendsPageConfig.applyLink}
						target="_blank"
						class="shrink-0 px-5 py-2.5 rounded-full bg-(--primary) text-white text-sm font-medium hover:scale-105 transition text-center"
					>
						申请友链
					</a>
				)}
			</div>
		)}

		<!-- 友链网格 -->
		{items.length > 0 ? (
			<div class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
				{items.map((friend) => (
					<a
						href={friend.siteurl}
						target="_blank"
						class="group flex flex-col gap-3 rounded-2xl border border-(--line-divider) p-4 hover:shadow-lg hover:-translate-y-0.5 transition"
					>
						<div class="flex items-center gap-3">
							<img src={friend.imgurl} alt={friend.title} class="w-12 h-12 rounded-full object-cover shrink-0" loading="lazy" />
							<div class="min-w-0">
								<h4 class="font-bold truncate">{friend.title}</h4>
								<div class="flex flex-wrap gap-1 mt-1">
									{friend.tags?.map((tag) => (
										<span class="text-xs px-2 py-0.5 rounded-full bg-black/5 dark:bg-white/10">{tag}</span>
									))}
								</div>
							</div>
						</div>
						<p class="text-sm text-(--content-meta) line-clamp-2 leading-5">{friend.desc}</p>
						<span class="text-sm font-medium text-(--primary) group-hover:translate-x-1 transition">访问 →</span>
					</a>
				))}
			</div>
		) : (
			<p class="mt-10 text-center text-(--content-meta)">暂无友链，敬请期待～</p>
		)}

		<!-- 评论区 -->
		{isCommentEnabled && (
			<div class="mt-10">
				<Comment />
			</div>
		)}
	</div>
</MainGridLayout>
