---
import Comment from "@components/comment/index.astro";
import MusicVisualizer from "@components/features/music-visualizer/MusicVisualizer.svelte";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { commentConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import "@/styles/pages/music-visualizer.css";

const isCommentEnabled =
	commentConfig?.type && commentConfig.type !== "none";
---


<MainGridLayout title={"我的音乐 - 3D可视化"} description="音乐地形可视化，沉浸式音乐体验" hasOwnH1={true}>
	<h1 class="sr-only">我的音乐 3D 可视化</h1>
	<div class="music-visualizer-page">
		<MusicVisualizer client:only="svelte" />
	</div>
	{isCommentEnabled && (
		<div class="card-base px-9 py-6 relative z-10 mt-6">
			<Comment customPath="/music/" />
		</div>
	)}
</MainGridLayout>
